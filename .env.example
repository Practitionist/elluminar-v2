# ==============================================================================
# Elluminar v2 — Clean-Sheet Hexagonal Monolith Environment Configuration
# ==============================================================================
# Copy this file to `.env` for local development.
# All variables are validated via `parseServerEnv()` in `@elluminar/db` with
# typed capability flags (`hasLiveDatabase`, `hasCloudflareR2`, `hasGeminiApi`,
# `hasRazorpay`, `hasUpstashRedis`) so local/CI runs degrade gracefully when omitted.

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL (`ap-south-1` Mumbai) & Prisma 8 Adapter
# ------------------------------------------------------------------------------
# Pooled connection string for application runtime queries (`@prisma/adapter-pg`)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/elluminar_v2?schema=public"

# Direct connection string for Prisma migrations & schema operations
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/elluminar_v2?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication (`better-auth` + B2B `@better-auth/sso`)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret for session signing & encryption
BETTER_AUTH_SECRET="elluminar-local-dev-secret-change-me-in-production-32chars"
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Zero-Egress Artifact Storage
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="elluminar-v2-artifacts"

# ------------------------------------------------------------------------------
# 4. AI Mentorship & Evaluation Engine (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Payments & India B2B GST Fulfillment (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. Async Workflows & Distributed Rate Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
